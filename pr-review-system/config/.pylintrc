# Pylint Configuration

[MASTER]
max-line-length = 120
disable = C0330, W0511

[DESIGN]
max-locals = 15
max-branches = 12
max-attributes = 7

[CLASSES]
max-parents = 7

[SIMILARITIES]
min-similarity-lines = 4
ignore-imports = yes

[LOGGING]
logging-format-style = new

[MESSAGES CONTROL]
disable =
    missing-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    duplicate-code
